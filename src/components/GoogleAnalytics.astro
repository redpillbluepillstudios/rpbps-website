---
import { googleAnalyticsId } from '../data/analytics';

const loaderUrl = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(googleAnalyticsId)}`;
---

<!-- Google tag (gtag.js) -->
<script is:inline async src={loaderUrl}></script>
<script is:inline define:vars={{ googleAnalyticsId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag('js', new Date());
  gtag('config', googleAnalyticsId);
</script>
