---
import { Image } from 'astro:assets';
import { getGameImage } from '../lib/gameImages';

interface Props {
  slug: string;
  title: string;
  thumbnail?: string;
  /** Rendered size in px (square). Source is 1000×1000. */
  size?: number;
  loading?: 'lazy' | 'eager';
}

const { slug, title, thumbnail = 'thumbnail.png', size = 600, loading = 'lazy' } = Astro.props;
const art = getGameImage(slug, thumbnail);
const initial = title.charAt(0);
---

<div class="game-art">
  <span class="game-art__fallback" aria-hidden="true">{initial}</span>
  <Image src={art} alt={`${title} cover art`} width={size} height={size} loading={loading} />
</div>

<style>
  .game-art {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 18px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, .8), inset 0 0 0 1px var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .game-art :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .game-art__fallback {
    font: 800 88px/1 var(--font-body);
    color: var(--red);
  }
</style>
