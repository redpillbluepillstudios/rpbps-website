---
import PlatformButton from './PlatformButton.astro';
import type { PlatformKey } from '../lib/platforms';

interface Props {
  availableOn: { platform: PlatformKey; url: string }[];
  appTitle: string;
}

const { availableOn, appTitle } = Astro.props;
---

<div class="platform-buttons">
  {availableOn.map((entry) => (
    <PlatformButton platform={entry.platform} url={entry.url} appTitle={appTitle} />
  ))}
</div>

<style>
  .platform-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
