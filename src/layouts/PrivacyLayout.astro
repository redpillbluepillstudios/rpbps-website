---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  updated?: Date;
  /** Route key for SEO (e.g. "/privacy"). */
  route?: string;
  /** SEO overrides (game privacy pages pass these since they aren't in seo.json). */
  seoTitle?: string;
  seoDescription?: string;
}

const { title, updated, route, seoTitle, seoDescription } = Astro.props;

const updatedLabel = updated
  ? updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : undefined;
---

<BaseLayout route={route} type="article" title={seoTitle} description={seoDescription}>
  <article class="policy">
    <header class="policy__head">
      <h1 class="policy__title">{title}</h1>
      {updatedLabel && <p class="policy__updated">Last updated {updatedLabel}</p>}
    </header>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>

<style>
  .policy {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 40px 80px;
  }
  .policy__head {
    padding-bottom: 22px;
    margin-bottom: 30px;
    border-bottom: 1px solid var(--line);
  }
  .policy__title {
    margin: 0;
    font: 700 40px/1.1 var(--font-display);
    color: var(--head);
  }
  .policy__updated {
    margin: 14px 0 0;
    font: 600 13px/1 var(--font-body);
    letter-spacing: .02em;
    color: var(--faint);
  }

  /* Prose: the rendered markdown body (global HTML → target with :global). */
  .prose :global(h2) {
    margin: 38px 0 12px;
    font: 600 22px/1.25 var(--font-display);
    color: var(--head);
  }
  .prose :global(h3) {
    margin: 28px 0 10px;
    font: 700 16px/1.3 var(--font-body);
    color: var(--head);
  }
  .prose :global(p) {
    margin: 0 0 16px;
    font: 400 16px/1.7 var(--font-body);
    color: var(--text);
    text-wrap: pretty;
  }
  .prose :global(ul) {
    margin: 0 0 16px;
    padding-left: 22px;
  }
  .prose :global(li) {
    margin: 0 0 8px;
    font: 400 16px/1.6 var(--font-body);
    color: var(--text);
  }
  .prose :global(strong) { color: var(--head); font-weight: 700; }
  .prose :global(a) {
    color: var(--red);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(a:hover) { color: #ff4b52; }

  @media (max-width: 600px) {
    .policy { padding: 40px 22px 64px; }
    .policy__title { font-size: 32px; }
  }
</style>
