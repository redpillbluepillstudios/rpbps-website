---
import { render, type CollectionEntry } from 'astro:content';
import AppArt from './AppArt.astro';
import PlatformButtons from './PlatformButtons.astro';
import { getThumbnailLink } from '../lib/apps';

interface Props {
  app: CollectionEntry<'apps'>;
}

const { app } = Astro.props;
const { title, tag, thumbnail, availableOn } = app.data;
const thumbLink = getThumbnailLink(app);
const { Content } = await render(app);
---

<article class="app rp-reveal">
  <div class="app__art-col">
    <AppArt slug={app.id} title={title} thumbnail={thumbnail} size={600} href={thumbLink?.url} ariaLabel={thumbLink?.label} />
  </div>
  <div class="app__body">
    <h2 class="app__title">{title}</h2>
    <div class="app__tag">{tag}</div>
    <div class="app__desc"><Content /></div>
    <hr class="app__rule" />
    <div class="app__available">Available on</div>
    <PlatformButtons availableOn={availableOn} appTitle={title} />
  </div>
</article>

<style>
  .app {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 60px;
    align-items: center;
    padding: 54px 0;
  }

  .app__title {
    margin: 0;
    font: 700 38px/1.12 var(--font-display);
    letter-spacing: 0;
    color: var(--head);
  }
  .app__tag {
    margin-top: 10px;
    font: 700 12px/1 var(--font-display);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--red);
  }
  .app__desc { margin: 18px 0 0; }
  .app__desc :global(p) {
    margin: 0;
    font: 400 17px/1.6 var(--font-body);
    color: var(--text);
    max-width: 580px;
    text-wrap: pretty;
  }
  .app__desc :global(strong),
  .app__desc :global(b) {
    color: var(--head);
    font-weight: 700;
  }
  .app__rule {
    height: 3px;
    width: 100%;
    max-width: 580px;
    margin: 26px 0;
    border: none;
    border-radius: 3px;
    background: var(--red);
  }
  .app__available {
    font: 700 13px/1 var(--font-body);
    letter-spacing: .02em;
    color: var(--head);
    margin-bottom: 16px;
  }

  @media (max-width: 820px) {
    .app {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 44px 0;
    }
    .app__art-col { width: 100%; max-width: 260px; margin: 0 auto; }
    .app__title { font-size: 34px; }
    /* The red rule reads like a section divider when stacked — hide it, keep the gap. */
    .app__rule { display: none; }
    .app__available { margin-top: 26px; }
  }
</style>
