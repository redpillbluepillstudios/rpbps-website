---
import logoFooter from '../assets/images/brand/logo-footer.svg';

const year = 2026;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-row">
      <p class="footer-desc">A one-person indie game studio, sometimes building more than just games.</p>
      <img class="footer-logo" src={logoFooter.src} alt="Red Pill Blue Pill Studios" width="104" height="104" />
      <div class="footer-links">
        <div class="footer-links__row">
          <a href="/#games" class="rp-link footer-link">Games</a>
          <span class="footer-sep" aria-hidden="true">·</span>
          <a href="/#utilities" class="rp-link footer-link">Utilities</a>
          <span class="footer-sep" aria-hidden="true">·</span>
          <a href="mailto:marcelo@redpillbluepillstudios.com" class="rp-link footer-link">Contact</a>
        </div>
        <a href="/privacy" class="rp-link footer-link">Privacy Policy</a>
      </div>
    </div>
    <div class="footer-copy">© {year} Red Pill, Blue Pill Studios, LLC</div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--red);
    padding: 56px 40px;
  }
  .site-footer__inner {
    max-width: 1080px;
    margin: 0 auto;
  }

  /* 3-column: description · logo · links */
  .footer-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 40px;
  }
  .footer-desc {
    margin: 0;
    max-width: 300px;
    font: 400 15px/1.6 var(--font-body);
    color: rgba(255, 255, 255, .9);
    text-wrap: pretty;
  }
  .footer-logo {
    height: 104px;
    width: auto;
    display: block;
  }
  .footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }
  .footer-links__row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .footer-sep { color: rgba(255, 255, 255, .5); }
  .footer-link {
    color: rgba(255, 255, 255, .9);
    font: 600 15px/1 var(--font-body);
  }
  .footer-link:hover { color: #fff; }

  .footer-copy {
    margin-top: 34px;
    text-align: center;
    font: 500 13px/1 var(--font-body);
    color: rgba(255, 255, 255, .72);
  }

  @media (max-width: 820px) {
    .footer-row {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 26px;
    }
    .footer-desc { max-width: 420px; }
    .footer-links { align-items: center; }
  }
</style>
