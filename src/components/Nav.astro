---
import logoHorizontal from '../assets/images/brand/logo-horizontal.svg';
import logoMark from '../assets/images/brand/logo-mark.svg';
import logoFull from '../assets/images/brand/logo.svg';

interface Props {
  /**
   * When true, the nav starts transparent and overlays the hero, turning solid on
   * scroll (home page). When false, it renders solid from the top (pages without a
   * hero, e.g. privacy) and does not toggle.
   */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

// One source of truth for the nav links (desktop bar + mobile menu).
const links = [
  { href: '/#games', label: 'Games' },
  { href: '/#utilities', label: 'Utilities' },
  { href: 'mailto:marcelo@redpillbluepillstudios.com', label: 'Contact' },
];
---

<nav class:list={['site-nav', { 'is-solid': !overlay }]} id="site-nav" data-overlay={overlay ? 'true' : undefined}>
  <a href="/" class="site-nav__brand" aria-label="Red Pill Blue Pill Studios — home">
    <img class="site-nav__logo site-nav__logo--full" src={logoHorizontal.src} alt="Red Pill Blue Pill Studios" width="297" height="34" />
    <img class="site-nav__logo site-nav__logo--mark" src={logoMark.src} alt="Red Pill Blue Pill Studios" width="60" height="32" />
  </a>

  <div class="site-nav__links">
    {links.map((l) => <a href={l.href} class="rp-link">{l.label}</a>)}
  </div>

  <button
    type="button"
    class="site-nav__toggle"
    id="nav-toggle"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span class="site-nav__bars" aria-hidden="true"></span>
  </button>
</nav>

<div class="mobile-menu" id="mobile-menu">
  <button type="button" class="mobile-menu__close" id="nav-close" aria-label="Close menu">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
      <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M6 18 18 6" />
    </svg>
  </button>
  <a href="/" class="mobile-menu__brand" aria-label="Red Pill Blue Pill Studios — home">
    <img src={logoFull.src} alt="Red Pill Blue Pill Studios" width="220" height="110" />
  </a>
  <nav class="mobile-menu__links" aria-label="Primary">
    {links.map((l) => <a href={l.href} class="mobile-menu__link">{l.label}</a>)}
  </nav>
</div>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 40px;
    background: linear-gradient(180deg, rgba(0, 0, 0, .55), rgba(0, 0, 0, 0));
    transition: background .25s ease, box-shadow .25s ease;
  }
  .site-nav.is-solid {
    background: var(--ink);
    box-shadow: 0 4px 22px rgba(0, 0, 0, .5);
    border-bottom: 1px solid var(--line-dark);
  }

  .site-nav__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .site-nav__logo {
    display: block;
    width: auto;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, .6));
  }
  .site-nav__logo--full { height: 34px; }
  .site-nav__logo--mark { height: 32px; display: none; } /* shown on mobile */

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 32px;
    font: 600 16px/1 var(--font-body);
  }
  .site-nav .rp-link {
    color: #e8eaee;
    text-shadow: 0 1px 6px rgba(0, 0, 0, .6);
  }
  .site-nav.is-solid .rp-link {
    color: #9aa0ad;
    text-shadow: none;
  }
  .site-nav .rp-link:hover { color: #fff; }

  /* Hamburger — hidden on desktop. */
  .site-nav__toggle {
    display: none;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: #e8eaee;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, .6));
  }
  .site-nav.is-solid .site-nav__toggle { color: #cfd3da; filter: none; }
  .site-nav__bars,
  .site-nav__bars::before,
  .site-nav__bars::after {
    display: block;
    width: 24px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  .site-nav__bars { position: relative; }
  .site-nav__bars::before,
  .site-nav__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .site-nav__bars::before { top: -7px; }
  .site-nav__bars::after { top: 7px; }

  /* Full-screen mobile menu — hidden until opened by JS. */
  .mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--ink);
    flex-direction: column;
    align-items: center;
    padding: 84px 24px 48px;
  }
  .mobile-menu.is-open { display: flex; }

  .mobile-menu__close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: #cfd3da;
  }
  .mobile-menu__close:hover { color: #fff; }

  .mobile-menu__brand {
    display: block;
    margin: 12px 0 44px;
  }
  .mobile-menu__brand img {
    width: 220px;
    max-width: 70vw;
    height: auto;
    display: block;
  }

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }
  .mobile-menu__link {
    font: 700 24px/1 var(--font-display);
    letter-spacing: .01em;
    color: #e8eaee;
    text-decoration: none;
  }
  .mobile-menu__link:hover { color: #fff; }

  /* Mobile: swap wordmark → pill mark, inline links → hamburger.
     Fires at 820px to match the hero's first mobile breakpoint. */
  @media (max-width: 820px) {
    .site-nav { padding: 14px 22px; }
    .site-nav__logo--full { display: none; }
    .site-nav__logo--mark { display: block; }
    .site-nav__links { display: none; }
    .site-nav__toggle { display: inline-flex; }
  }
</style>
