---
import { getCollection, getEntry, render } from 'astro:content';
import PrivacyLayout from '../../../layouts/PrivacyLayout.astro';

// A route exists only for games that have a privacy.md (the gamePrivacy collection).
export async function getStaticPaths() {
  const policies = await getCollection('gamePrivacy');
  return policies.map((policy) => ({ params: { slug: policy.id }, props: { policy } }));
}

const { policy } = Astro.props;
const game = await getEntry('games', policy.id);
const gameTitle = game?.data.title ?? policy.id;
const { Content } = await render(policy);
---

<PrivacyLayout
  title={policy.data.title}
  updated={policy.data.updated}
  seoTitle={`${policy.data.title} — Red Pill Blue Pill Studios`}
  seoDescription={`Privacy policy for ${gameTitle} by Red Pill Blue Pill Studios.`}
>
  <Content />
</PrivacyLayout>
